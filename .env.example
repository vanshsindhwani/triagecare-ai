# TriageCare AI Environment Configuration
PORT=3000

# Database Configuration (MongoDB Mongoose ORM)
# Connect to local MongoDB instance or MongoDB Atlas Cloud Cluster
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/triagecare?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/triagecare

# Optional External Dense Semantic Embeddings Microservice (Python Sentence-BERT)
# If offline, the Node.js backend automatically executes mathematical TF-IDF Cosine Similarity
SENTENCE_BERT_URL=http://localhost:8000
